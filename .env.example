# Copie para .env (ou defina no seu servidor) e ajuste.
NODE_ENV=production
PORT=8080
DB_PATH=data/classicbet.db

# Administrador inicial (obrigatório em produção)
ADMIN_EMAIL=admin@seudominio.pt
# A conta é criada (ou, se já existir, passa a admin com esta palavra-passe) em cada arranque.
ADMIN_PASSWORD=troque-esta-palavra-passe

# demo     = depósitos creditados de imediato, sem dinheiro real (para testes)
# disabled = depósitos recusados até ligar um fornecedor de pagamentos
PAYMENTS_MODE=demo

# Limites (em cêntimos)
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=100000
MAX_PAYOUT_CENTS=5000000
MIN_DEPOSIT_CENTS=500
MAX_DEPOSIT_CENTS=500000
MIN_WITHDRAW_CENTS=1000

# Futebol ao vivo — sports.bzzoiro.com (token gratuito). Sem token, usam-se eventos de exemplo.
BZZOIRO_API_TOKEN=
BZZOIRO_DAYS=3
BZZOIRO_MAX_ODDS_CALLS=60
BZZOIRO_MAX_RESULT_CALLS=40

# WebSocket ao vivo (addon pago): odds e marcador em jogo. 0 desliga.
BZZOIRO_LIVE_WS=1
BZZOIRO_LIVE_MAX_SOCKETS=5
# Casa de apostas cujas odds em jogo (odds_book) são pedidas no WebSocket; vazio = só consenso
BZZOIRO_LIVE_BOOKMAKER=bet365
# Odd em jogo que não muda há mais do que isto é considerada parada e o mercado fecha
LIVE_ODDS_STALE_SECONDS=600
# Apostas em jogo são recusadas se a última odd ao vivo tiver mais do que isto (segundos)
LIVE_ODDS_MAX_AGE_SECONDS=180
# Placar e odds ao vivo pedidos ao fornecedor a cada X segundos (mínimo 2)
LIVE_POLL_SECONDS=5
# Odds pré-jogo de cada jogo relidas a cada X segundos (metade na última hora; mínimo 20)
PREMATCH_ODDS_SECONDS=60

# Ténis ATP/WTA (mesmo token; precisa do Sports Addon). 0 desliga.
TENNIS=1
TENNIS_DAYS=3

# Sports Addon: desportos a importar (vazio desliga) e dias de jogos
SPORTS_ADDON=basquetebol,hoquei,dardos,esports
SPORTS_DAYS=3

# Jogo adiado sem nova data: apostas anuladas depois de X horas
POSTPONED_VOID_HOURS=48

# Casino — Agent API v4 do agregador (modo Transfer). Sem os dois, o casino mostra só o catálogo de exemplo.
CASINO_API_URL=
CASINO_API_TOKEN=
# Idioma dos jogos (6 = Português)
CASINO_LANG=6
CASINO_MIN_TRANSFER_CENTS=100

# PropLine (api.prop-line.com) — 2.ª fonte de odds, só para mercados sem odds do Bzzoiro.
# Defina a chave nas variáveis do servidor (Railway → Variables); nunca no código.
PROPLINE_API_KEY=
# Pedidos por dia que a Bet62 pode gastar (grátis: 1000; Streaming 79$: 1 000 000 → p.ex. 800000)
PROPLINE_DAILY_REQUESTS=900
# Competições (vazio = EPL, LaLiga, Serie A, Bundesliga, Ligue 1, MLS, ténis, NBA, NHL)
PROPLINE_SPORTS=
# Odds ao vivo da PropLine: segundos entre leituras (0 = desligado) e idade máxima aceite
PROPLINE_LIVE_SECONDS=60
PROPLINE_LIVE_MAX_AGE=90

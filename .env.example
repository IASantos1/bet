# Copie para .env (ou defina no seu servidor) e ajuste.
NODE_ENV=production
PORT=8080
DB_PATH=data/classicbet.db

# Administrador inicial (obrigatório em produção)
ADMIN_EMAIL=admin@seudominio.pt
# A conta é criada (ou, se já existir, passa a admin com esta palavra-passe) em cada arranque.
ADMIN_PASSWORD=troque-esta-palavra-passe

# demo     = depósitos creditados de imediato, sem dinheiro real (para testes)
# disabled = depósitos recusados até ligar um fornecedor de pagamentos
PAYMENTS_MODE=demo

# Limites (em cêntimos)
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=100000
MAX_PAYOUT_CENTS=5000000
MIN_DEPOSIT_CENTS=500
MAX_DEPOSIT_CENTS=500000
MIN_WITHDRAW_CENTS=1000

# Futebol ao vivo — sports.bzzoiro.com (token gratuito). Sem token, usam-se eventos de exemplo.
BZZOIRO_API_TOKEN=
BZZOIRO_DAYS=3
BZZOIRO_MAX_ODDS_CALLS=60
BZZOIRO_MAX_RESULT_CALLS=40

# WebSocket ao vivo (addon pago): odds e marcador em jogo. 0 desliga.
BZZOIRO_LIVE_WS=1
BZZOIRO_LIVE_MAX_SOCKETS=5
# Pedidos por minuto que a conta Bzzoiro pode fazer (todos os desportos juntos); baixe se aparecer 429
BZZOIRO_MAX_RPM=60
# Odds em jogo por REST no ténis/basquetebol/hóquei/dardos/CS2 (quase nunca existem; a PropLine cobre). 1 = ligar
BZZOIRO_REST_LIVE_ODDS=0
# Segundos entre leituras da lista ao vivo desses desportos (ténis com WebSocket: o dobro)
SPORTS_LIVE_POLL_SECONDS=15
# Casa de apostas cujas odds em jogo (odds_book) são pedidas no WebSocket; vazio = só consenso
BZZOIRO_LIVE_BOOKMAKER=bet365
# Odd em jogo que não muda há mais do que isto é considerada parada e o mercado fecha
LIVE_ODDS_STALE_SECONDS=600
# Apostas em jogo são recusadas se a última odd ao vivo tiver mais do que isto (segundos)
LIVE_ODDS_MAX_AGE_SECONDS=180
# Placar e odds ao vivo pedidos ao fornecedor a cada X segundos (mínimo 2)
LIVE_POLL_SECONDS=5
# Odds pré-jogo de cada jogo relidas a cada X segundos (metade na última hora; mínimo 20)
PREMATCH_ODDS_SECONDS=60

# Ténis ATP/WTA (mesmo token; precisa do Sports Addon). 0 desliga.
TENNIS=1
TENNIS_DAYS=3

# Sports Addon: desportos a importar (vazio desliga) e dias de jogos
SPORTS_ADDON=basquetebol,hoquei,dardos,esports
SPORTS_DAYS=3

# Jogo adiado sem nova data: apostas anuladas depois de X horas
POSTPONED_VOID_HOURS=48

# Casino — Agent API v4 do agregador (modo Transfer). Sem os dois, o casino mostra só o catálogo de exemplo.
CASINO_API_URL=
CASINO_API_TOKEN=
# Idioma dos jogos (6 = Português)
CASINO_LANG=6
CASINO_MIN_TRANSFER_CENTS=100

# PropLine (api.prop-line.com) — 2.ª fonte de odds, só para mercados sem odds do Bzzoiro.
# Defina a chave nas variáveis do servidor (Railway → Variables); nunca no código.
PROPLINE_API_KEY=
# Pedidos por dia que a Bet62 pode gastar (grátis: 1000; Streaming 79$: 1 000 000 → p.ex. 800000)
PROPLINE_DAILY_REQUESTS=900
# Competições (vazio = EPL, LaLiga, Serie A, Bundesliga, Ligue 1, MLS, ténis, NBA, NHL)
PROPLINE_SPORTS=
# Odds ao vivo da PropLine: segundos entre leituras (0 = desligado) e idade máxima aceite
PROPLINE_LIVE_SECONDS=60
PROPLINE_LIVE_MAX_AGE=90

# WinHouse: fonte de jogos, odds e resultados (futebol, basquetebol, hóquei, ténis).
# Para ficar só com a WinHouse, apague BZZOIRO_API_TOKEN. Admin → Feed mostra o estado.
WINHOUSE_BASE_URL=
WINHOUSE_LANG=pt
# Rotas (opcionais; por defeito as conhecidas). {lang} e {gameId} são substituídos.
# WINHOUSE_LIVE=/ajax/livegames?lang={lang}
# WINHOUSE_PREMATCH_MAIN=/ajax/prematchgamesmainleague?lang={lang}
# WINHOUSE_PREMATCH_TOP=/ajax/toptenprematchgames?lang={lang}
# WINHOUSE_PREMATCH_24H=/ajax/prematchgames24hour?lang={lang}
# WINHOUSE_PREMATCH_EVENT=/ajax/prematchgame/{gameId}?lang={lang}
# WINHOUSE_LIVE_EVENT=/ajax/livegame/{gameId}?lang={lang}
# Importação (WINHOUSE_FEED=0 desliga) e intervalos
WINHOUSE_LIVE_INTERVAL_MS=15000
WINHOUSE_PREMATCH_INTERVAL_MS=60000
# Fuso das horas da WinHouse em minutos face a UTC (vazio = estimado pelos jogos ao vivo)
WINHOUSE_TZ_OFFSET_MINUTES=
# Tempo fora da lista ao vivo antes de liquidar pelo último placar
WINHOUSE_FINISH_CONFIRM_SECONDS=600
# Jogos femininos e de escalões jovens (U19, Sub-20, Junior…) ficam de fora; 0 = mostrar
WINHOUSE_BLOCK_WOMEN=1
WINHOUSE_BLOCK_YOUTH=1
# Futebol virtual (FIFA 4x4/5x5, subsoccer, cyber…), ténis de mesa ATT/Setka Cup/TT Cup e ténis UTR
# ficam de fora; 0 = mostrar. WINHOUSE_BLOCK_LEAGUES: mais termos a bloquear, separados por vírgulas
WINHOUSE_BLOCK_MINOR=1
# Futebol: só as competições da lista interna (Premier League, La Liga, UEFA…). Para outra lista,
# nomes como a WinHouse os escreve separados por ; (ex.: England. Premier League;Spain. La Liga); * = todas.
# WINHOUSE_FOOTBALL_LEAGUES=
WINHOUSE_BLOCK_LEAGUES=
# Todos os mercados de cada jogo vêm da página dele (prematchgame/{id}): jogos das próximas
# WINHOUSE_DETAIL_HOURS horas, até WINHOUSE_DETAIL_PER_CYCLE páginas por minuto, cada uma de novo
# após WINHOUSE_DETAIL_REFRESH_MINUTES. 0 páginas por minuto desliga.
WINHOUSE_DETAIL_HOURS=12
WINHOUSE_DETAIL_PER_CYCLE=20
WINHOUSE_DETAIL_REFRESH_MINUTES=30
# Ao vivo, todos os mercados vêm da página do jogo em direto (WINHOUSE_LIVE_EVENT): até
# WINHOUSE_LIVE_DETAIL_PER_CYCLE páginas a cada 10 s, cada jogo a cada WINHOUSE_LIVE_DETAIL_SECONDS.
# 0 páginas desliga. As odds da página valem 2× esse tempo e caem a cada golo.
WINHOUSE_LIVE_DETAIL_PER_CYCLE=10
# Tracker dos jogos de futebol ao vivo (estatísticas, bola, situação, cronologia): só é lido para
# os jogos que alguém tem abertos, a cada WINHOUSE_TRACKER_POLL_MS. 0 desliga.
WINHOUSE_TRACKER=1
WINHOUSE_TRACKER_POLL_MS=2000
# Posição da bola e situação em tempo real pelo WebSocket do tracker (ws-widget); 0 = só widget-data
WINHOUSE_TRACKER_WS=1
# Odds ao vivo em tempo real pelo socket.io da WinHouse (/sio, evento new-coefs); 0 = só leituras das páginas
WINHOUSE_ODDS_PUSH=1
# Chave do iframe (ifr_…, a do portal WinHouse): marca os jogos com transmissão ao vivo (/ajax/streams).
# WINHOUSE_TENANT=
# Vídeo ao vivo em HLS para o nosso player (/api/live/:id). Só ligar quando o acordo com a WinHouse
# permitir o stream fora do iframe. WINHOUSE_API_KEY: credencial servidor-a-servidor, se a WinHouse der.
# WINHOUSE_HLS=1
# WINHOUSE_API_KEY=
# WINHOUSE_TV_URL=https://winhouse.bet
# O vídeo pede um jogador com sessão no livro (carteira integrada, modelo B): a wallet API key do portal
# (Seamless wallet) e o id de um jogador da carteira com depósito. A chave nunca sai do servidor.
# WINHOUSE_WALLET_KEY=
# WINHOUSE_STREAM_PLAYER=
# WINHOUSE_WS_WIDGET=/ws-widget?api_key={akey}&event_id={eid}
# WINHOUSE_WIDGET=/ajax/widget?event_id={gameId}&bg=transparent
# WINHOUSE_WIDGET_DATA=/widget-data?event_id={eid}&api_key={akey}
WINHOUSE_LIVE_DETAIL_SECONDS=30
